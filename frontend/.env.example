# Frontend environment variables (React / Create React App).
# All keys MUST start with REACT_APP_. Restart `npm start` after changing.

# Pinata (IPFS) credentials: get these from pinata.cloud
REACT_APP_PINATA_API_KEY=your_pinata_api_key
REACT_APP_PINATA_API_SECRET=your_pinata_api_secret

# Deployed smart contract address (printed by deploy.js)
REACT_APP_CONTRACT_ADDRESS=0xYourContractAddress

# Target chain: 31337 = local Hardhat, 80002 = Polygon Amoy
REACT_APP_CHAIN_ID=31337

# true = simulate blockchain + IPFS in the browser (no wallet or keys needed)
REACT_APP_DEMO_MODE=false
